# MongoDB connection string, including the database name
MONGODB_URI=

# Generate a secret with: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary credentials (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=

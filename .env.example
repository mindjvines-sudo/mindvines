# Use https://mindjvines.vercel.app in Vercel Production settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

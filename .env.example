# MongoDB connection string, including the database name
MONGODB_URI=

# Generate a secret with: openssl rand -base64 32
SESSION_SECRET=

# Cloudinary credentials (server only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use https://mindjvines.vercel.app in Vercel Production settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay (server only). Use test-mode keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard > Webhooks; point it at /api/razorpay/webhook
# and enable payment.captured, order.paid and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
# GST added to plan prices at checkout (default 18)
GST_RATE_PERCENT=18
# Vercel Cron sends this to /api/cron/expire-subscriptions. Any long random string.
CRON_SECRET=

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Email (server only). Any SMTP provider works (Gmail app password, Hostinger,
# Amazon SES, Brevo…). Without SMTP_HOST and EMAIL_FROM nothing is sent.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465, otherwise leave false (STARTTLS on 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The address mail is sent from; it must be allowed by your SMTP provider
EMAIL_FROM=
EMAIL_FROM_NAME=Mindvines
# Where parents' replies go (optional)
EMAIL_REPLY_TO=
# Staff alerts go here; separate several with commas (optional)
EMAIL_ADMIN_TO=
# Subscriber/renewal alerts: choose the recipient in Admin > Settings.
# A blank setting sends to mindjvines@gmail.com (separate from EMAIL_ADMIN_TO).
